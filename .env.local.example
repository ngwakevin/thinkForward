## Authentication (NextAuth + Microsoft Entra ID)
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET="replace-with-random-32+ chars"
# Azure AD (Entra ID) single-tenant (AzureADMyOrg)
AZURE_AD_CLIENT_ID="3ca9d2ec-a691-4a58-9658-ecd4fb8d6918"
# Client secret value (create in App registrations > Certificates & secrets). Do NOT commit real secret.
AZURE_AD_CLIENT_SECRET=""
# Tenant ID (Directory ID) of your organization
AZURE_AD_TENANT_ID="<your-tenant-id>"

# Example of other optional public envs
NEXT_PUBLIC_CALENDLY_URL=
# Azure Cosmos DB Configuration
COSMOS_ENDPOINT="https://your-cosmos-db-instance.documents.azure.com:443/"
COSMOS_KEY="your-cosmos-primary-key-here"
COSMOS_DATABASE_ID="thinkforward"

# Legacy Database (Azure SQL / SQL Server) - being migrated to Cosmos
# Format: sqlserver://USER:PASSWORD@HOST:PORT;database=DBNAME;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://username:StrongPassword123!@your-sql-server.database.windows.net:1433;database=thinkforward_dev;encrypt=true;trustServerCertificate=false"
