# Production environment variables for Azure deployment

# Core App Settings
NODE_ENV=production
PORT=8080

# Authentication - Azure AD
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# Authentication - NextAuth
NEXTAUTH_URL=https://your-app-name.azurewebsites.net
NEXTAUTH_SECRET=your-nextauth-secret-key

# Azure Cosmos DB
COSMOS_DB_ENDPOINT=https://your-cosmosdb-name.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmosdb-primary-key
COSMOS_DB_DATABASE_ID=thinkforward
COSMOS_DB_CONTAINER_ID=users

# Azure Blob Storage
STORAGE_ACCOUNT_NAME=your-storage-account-name
STORAGE_ACCOUNT_KEY=your-storage-account-key
STORAGE_CONTAINER_NAME=content

# Azure Key Vault
KEY_VAULT_URL=https://your-key-vault-name.vault.azure.net/

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-app-insights-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/
APPLICATIONINSIGHTS_ROLE_NAME=thinkforward-web

# Website Configuration
WEBSITE_RUN_FROM_PACKAGE=1
WEBSITE_NODE_DEFAULT_VERSION=~20
SCM_DO_BUILD_DURING_DEPLOYMENT=false

# NOTE: In production, these values should be set through Azure App Service Configuration
# and not committed to source control. This file is just a template.