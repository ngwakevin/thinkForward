# Production environment variables for Azure deployment - TEMPLATE
# These variables are replaced by Azure App Service application settings in production
# This file contains no real secrets, just placeholders for the build process

# Core App Settings
NODE_ENV=production
PORT=8080

# Authentication - Azure AD
AZURE_AD_CLIENT_ID=placeholder-client-id
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_SECRET=placeholder-for-build

# Authentication - NextAuth
NEXTAUTH_URL=https://thinkforward-dev.azurewebsites.net
NEXTAUTH_SECRET=placeholder-secret-will-be-replaced-in-production-env

# Azure Resources - Cosmos DB
COSMOS_DB_ENDPOINT=https://placeholder.documents.azure.com:443/
COSMOS_DB_KEY=placeholder-key-for-build
COSMOS_DB_DATABASE=thinkforward

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://thinkforward-dev.azurewebsites.net