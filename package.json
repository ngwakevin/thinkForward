{
  "name": "gouply",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3006",
    "dev:auto": "bash scripts/dev-env.sh",
    "build": "next build",
    "start": "next start -p $PORT",
    "start:custom": "node server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "postbuild": "node scripts/postbuild.cjs",
    "clean": "rm -rf .next",
    "reset": "rm -rf .next node_modules package-lock.json && npm install",
    "rebuild:dev": "npm run clean && npm run dev",
    "rebuild:prod": "npm run clean && npm run build && npm start",
    "zip:prebuild": "bash scripts/zip-prebuild.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "prepare:github-actions": "bash scripts/zip-prebuild.sh",
    "card:png": "node scripts/export-cards.mjs",
    "backfill:identity": "tsx scripts/backfill-identity.ts",
    "postinstall": "if [ \"$SCM_DO_BUILD_DURING_DEPLOYMENT\" = \"true\" ] || [ \"$WEBSITE_RUN_FROM_PACKAGE\" = \"1\" ]; then echo 'Remote build detected: prisma generate + next build'; npx prisma generate && npm run build; fi"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "clsx": "2.1.1",
    "fuse.js": "7.0.0",
    "gray-matter": "4.0.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "0.441.0",
    "next": "14.2.5",
    "next-auth": "^4.24.11",
    "next-mdx-remote": "5.0.0",
    "nodemailer": "6.9.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.5.0",
    "rehype-pretty-code": "0.13.1",
    "remark-directive": "2.0.1",
    "@prisma/client": "5.18.0",
    "prisma": "5.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.13",
    "@types/node": "20.12.12",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.22",
    "autoprefixer": "10.4.19",
    "dotenv": "^17.2.2",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "sharp": "0.33.3",
    "tailwindcss": "3.4.7",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  }
}
